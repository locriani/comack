# Comack server settings — copy to .env (gitignored).
# Real environment variables (e.g. the systemd unit or docker-compose) win over this file.
# Defaults below mirror server/config.py.

# ── Server network bindings ────────────────────────────────────────────────
# Address/port for the FastAPI server (dashboard, WebSocket audio, comic API).
HOST=0.0.0.0
PORT=8000

# ── LLM (OpenAI-compatible) ────────────────────────────────────────────────
# OpenAI-compatible chat endpoint (llama.cpp, vLLM, Ollama...). Required: no LLM calls without it.
LLM_URL=http://localhost:8080/
# Model name sent with each request (llama.cpp ignores it)
LLM_MODEL=
# Separate small, fast server for the per-sentence miner pass (empty = LLM_URL)
MINER_LLM_URL=

# ── Whisper speech-to-text ─────────────────────────────────────────────────
# Model size/name passed to faster-whisper (e.g. tiny.en, base.en, small.en)
WHISPER_MODEL_SIZE=base.en
# 'cuda', 'cpu', or 'auto'
WHISPER_DEVICE=auto
# Hallucination filters (Whisper's own thresholds): a transcribed segment is skipped when it is
# too repetitive, or probably not speech AND low-confidence.
WHISPER_MIN_AVG_LOGPROB=-1.0
WHISPER_MAX_COMPRESSION=2.4
WHISPER_MAX_NO_SPEECH=0.6
# Set to 1 once models are cached to skip the per-load huggingface.co revision check
# (read by huggingface_hub, not config.py). Unset when a new model needs downloading.
#HF_HUB_OFFLINE=1

# ── Comic cadence & triggers ───────────────────────────────────────────────
# "Sneaky" mode: seconds of room silence before a new comic is shown (0 = off:
# a comic is shown as soon as it is rendered, even mid-conversation).
SNEAKY_SILENCE_SECONDS=0
# Spoken phrases that force an immediate refresh (comma-separated)
SECRET_PHRASES=alpha protocol
# A new comic is generated once the room notes the last comic asked for have arrived,
# but never sooner than COMIC_MIN_MINUTES and never later than COMIC_MAX_MINUTES.
COMIC_MIN_MINUTES=5
COMIC_MAX_MINUTES=1440
# How many scrambled lines each comic should collect (feeds the LLM prompt)
DEFAULT_LINES_WANTED=8
# Buffered speech is transcribed, scrambled and mined this often (trigger phrases are
# checked continuously on a rolling few-second window instead)
PROCESS_INTERVAL_MINUTES=2

# ── Privacy scramble ───────────────────────────────────────────────────────
# Stochastic part-of-speech word-scramble rate: fraction of eligible words swapped
# for same-part-of-speech stand-ins before anything is stored or sent to the LLM.
POS_SCRAMBLE_RATE=0.25

# ── Story arcs ─────────────────────────────────────────────────────────────
# Narrative arc length bounds, in panels
ARC_MIN_PANELS=12
ARC_MAX_PANELS=60

# ── Image generation (local diffusers or external API) ─────────────────────
# Local model (defaults to fast 1-step SD-Turbo for immediate responsiveness)
FLUX_MODEL_ID=stabilityai/sd-turbo
# 'cuda', 'mps', or 'cpu'
FLUX_DEVICE=cuda
FLUX_INFERENCE_STEPS=1
FLUX_GUIDANCE_SCALE=0.0
# Where to fetch the GGUF-quantized FLUX transformer from (downloaded once, cached)
FLUX_GGUF_URL=https://huggingface.co/city96/FLUX.1-schnell-gguf/blob/main/flux1-schnell-Q4_K_S.gguf
# Pause generation (and wait) when free VRAM drops below this, so the LLM can breathe
FLUX_MIN_FREE_VRAM_GB=10.5
FLUX_VRAM_WAIT_SECONDS=180
# External image API (/v1/images/generations); empty = render locally
FLUX_API_URL=

# ── Display ────────────────────────────────────────────────────────────────
# E-paper panel size — fixed in code, listed for reference (not env-overridable)
#DISPLAY_WIDTH=800
#DISPLAY_HEIGHT=480
