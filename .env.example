# Copy to .env (gitignored). Real environment variables (e.g. the systemd unit) win over this file.

# OpenAI-compatible LLM server (llama.cpp, vLLM, Ollama...). Required: no LLM calls without it.
LLM_URL=http://localhost:8080/
# Model name sent with each request (llama.cpp ignores it)
LLM_MODEL=
# Separate small, fast server for the per-sentence miner pass (empty = LLM_URL)
MINER_LLM_URL=
# External image API (/v1/images/generations); empty = render locally
FLUX_API_URL=
