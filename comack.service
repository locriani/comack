[Unit]
Description=Comack Continuous Comic Server
After=network.target

[Service]
Type=simple
User=comack-server
WorkingDirectory=/home/comack-server/comack
ExecStart=/home/comack-server/comack/.venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=LLM_URL=http://comack-server.example-tailnet.ts.net:80/
Environment=FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
Environment=SNEAKY_SILENCE_SECONDS=50.0
# Models are already cached; skip the per-load huggingface.co revision check.
# Unset this once when a new model needs downloading.
Environment=HF_HUB_OFFLINE=1

[Install]
WantedBy=multi-user.target
