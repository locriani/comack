# ── Comack preset: local-GPU ─────────────────────────────────────────────────
# Images render on this machine's CUDA GPU with FLUX.1-schnell (GGUF-quantized,
# ~7 GB download, ~10 GB VRAM headroom shared with the LLM). Best image quality
# and latency; the comack-server default profile.
#
# Start from it:
#   cp presets/local-gpu.env .env
# ...then point LLM_URL at your OpenAI-compatible endpoint (llama.cpp, vLLM,
# Ollama...). See .env.example for every other setting.

# Story mining LLM
LLM_URL=http://localhost:8080/

# Local FLUX rendering (FLUX_API_URL empty = render here)
FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
FLUX_DEVICE=cuda
FLUX_INFERENCE_STEPS=4
FLUX_API_URL=
FLUX_MIN_FREE_VRAM_GB=10.5
FLUX_VRAM_WAIT_SECONDS=180
