# ── Comack preset: cpu-only ──────────────────────────────────────────────────
# No GPU anywhere: Whisper runs on CPU, images render locally with 1-step
# SD-Turbo (the only model fast enough to tolerate on CPU), and the comic
# cadence stretches out to absorb the slower renders.
#
# Start from it:
#   cp presets/cpu-only.env .env
# ...then point LLM_URL at your OpenAI-compatible endpoint (llama.cpp, vLLM,
# Ollama...). See .env.example for every other setting.

# Story mining LLM
LLM_URL=http://localhost:8080/

# Whisper on CPU: smaller and faster
WHISPER_DEVICE=cpu
WHISPER_MODEL_SIZE=tiny.en

# Local rendering on CPU: 1-step SD-Turbo only
FLUX_DEVICE=cpu
FLUX_MODEL_ID=stabilityai/sd-turbo
FLUX_INFERENCE_STEPS=1
FLUX_MIN_FREE_VRAM_GB=0

# CPU renders are slow: fewer panels, more space between comics
ARC_MAX_PANELS=30
COMIC_MIN_MINUTES=15
PROCESS_INTERVAL_MINUTES=5
