# ── Comack preset: external-API ──────────────────────────────────────────────
# Images render on a remote OpenAI-compatible image endpoint (FLUX_API_URL),
# so this machine needs no GPU at all. The story-mining LLM points off-box
# too. Good for a Raspberry Pi / small box driving the e-paper display while
# a beefier machine does the rendering.
#
# Start from it:
#   cp presets/external-api.env .env
# ...then set both URLs. See .env.example for every other setting.

# Story mining LLM (remote, OpenRouter, or on another machine)
LLM_URL=http://your-llm-host:8080/
#LLM_MODEL=
# If the chat endpoint authenticates (OpenRouter, OpenAI…), its Bearer key
# rides on every story call and the connectivity probe (masked in GET /api/config):
#LLM_API_KEY=

# Remote image API (OpenAI-compatible /v1/images/generations). Setting it means
# remote-only: panels render on the API and the local diffusers stack is never touched.
FLUX_API_URL=http://your-image-host:8000

# If the endpoint authenticates, its Bearer key rides on every remote render
# and the connectivity probe (masked in GET /api/config):
#FLUX_API_KEY=
# When the endpoint needs an explicit model name (empty = omit, provider default):
#FLUX_API_MODEL=

# No local rendering: keep the VRAM guard off and devices on cpu
FLUX_DEVICE=cpu
FLUX_MIN_FREE_VRAM_GB=0
