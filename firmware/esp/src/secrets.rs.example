//! Copy to `secrets.rs` (gitignored) — or let `scripts/provision-device.sh`
//! render a temporary one for a USB flash.
//!
//! Default is empty on purpose: this is an open-source tree, so the compile-time
//! fallback must not carry real Wi-Fi passwords or Tailscale keys. An empty
//! network list boots the on-device setup portal; the portal (or a one-shot
//! provision flash) writes credentials to NVS on the device only.
//!
//! `provision-device.sh` scrubs `secrets.rs` back to this empty shape after a
//! successful flash so leftovers do not sit in the working tree.

use core::ffi::CStr;

use comack_core::domain::{WifiCredentials, MAX_NETWORKS};

/// Networks to try, primary first. Leave empty for portal-first boot.
pub fn wifi_networks() -> heapless::Vec<WifiCredentials, MAX_NETWORKS> {
    heapless::Vec::<WifiCredentials, MAX_NETWORKS>::new()
}

/// Generate at https://login.tailscale.com/admin/settings/keys — empty = LAN-only.
pub const TAILSCALE_AUTH_KEY: &CStr = c"";

/// Comack server host (MagicDNS or IP). Empty falls back to `config::SERVER`.
pub const SERVER_HOST: &str = "";
/// Comack server port. Ignored when `SERVER_HOST` is empty.
pub const SERVER_PORT: u16 = 8000;

/// The device identity the server issued: create the device on the server's
/// settings page (Devices card) and paste the id and its per-device token —
/// the token is shown exactly once, at creation. Leave BOTH empty to present
/// no identity: the server then treats this device as its `default` device,
/// exactly like pre-identity firmware. An id without its matching token is
/// rejected by the server, never silently downgraded.
pub const DEVICE_ID: &str = "";
pub const DEVICE_TOKEN: &str = "";
