//! Copy to `secrets.rs` (gitignored) and fill in.
//!
//! These values are the FALLBACK: the device's config store (NVS) is read
//! first, so a device provisioned through the setup portal or
//! `provision-device.sh` runs with the stored configuration and these are
//! only used when nothing is stored.

use core::ffi::CStr;

use comack_core::domain::{WifiCredentials, MAX_NETWORKS};

/// Networks to try, primary first; the device rotates on every disconnect.
pub fn wifi_networks() -> heapless::Vec<WifiCredentials, MAX_NETWORKS> {
    heapless::Vec::from([WifiCredentials::new("YOUR_SSID", "YOUR_PASSWORD")
        .expect("SSID or password exceeds the bounded buffers")])
}

/// Generate at https://login.tailscale.com/admin/settings/keys
pub const TAILSCALE_AUTH_KEY: &CStr = c"tskey-auth-XXXX";

/// The device identity the server issued: create the device on the server's
/// settings page (Devices card) and paste the id and its per-device token —
/// the token is shown exactly once, at creation. Leave BOTH empty to present
/// no identity: the server then treats this device as its `default` device,
/// exactly like pre-identity firmware. An id without its matching token is
/// rejected by the server, never silently downgraded.
pub const DEVICE_ID: &str = "";
pub const DEVICE_TOKEN: &str = "";
